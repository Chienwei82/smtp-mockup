<?xml version="1.0" encoding="utf-8"?>
<!--
  Perfil de publicación del servicio (RF-10, D-13).

  Existe para que el comando de publicación sea el mismo en cualquier máquina y no dependa de
  recordar los flags:

      dotnet publish src/SmtpMockup.Host -p:PublishProfile=win-x64

  OJO con el orden de evaluación: un perfil se importa DESPUÉS del cuerpo del .csproj, así que una
  condición del csproj sobre '$(RuntimeIdentifier)' aún no ve el RID que fija este archivo, y el
  publish salía con las DLL sueltas en vez de un único .exe. Por eso los valores van aquí. El .csproj
  los repite para el caso 'dotnet publish -r win-x64' a pelo, donde el RID sí es una propiedad
  global y está disponible durante la evaluación.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- Single-file: install-service.ps1 instala un solo .exe y "copiar el .exe" es toda la
         instalación. Sin trimming: MailKit/MimeKit y el binder de Options usan reflexión, y un
         publish recortado rompe en runtime, no al compilar (DESIGN §9). -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Sin esto, Windows bloquea el .exe mientras se extrae la caché nativa.
         IncludeAllContentForSelfExtract se deja OFF a propósito: extraería wwwroot a %TEMP% en cada
         arranque, y como servicio eso es escribir en disco en cada start. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>