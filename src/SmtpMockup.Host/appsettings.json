{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SmtpMockup.Smtp": "Debug"
    }
  },
  "Hosting": {
    "Mode": "Auto",
    "LogDirectory": "logs",
    "LogFileName": "smtp-mockup-{Date}.log",
    "LogRetentionDays": 7,
    "EventLogSource": "smtp-mockup",
    "EventLogLevel": "Information"
  },
  "Smtp": {
    "Plain": {
      "Enabled": true,
      "Port": 8025,
      "BindAddress": "127.0.0.1",
      "Security": "None"
    },
    "StartTls": {
      "Enabled": true,
      "Port": 8443,
      "BindAddress": "127.0.0.1",
      "Security": "StartTls"
    },
    "MaxMessageSizeMb": 25
  },
  "Certificate": {
    "Mode": "Auto",
    "Path": "certs/dev.pfx",
    "Password": "",
    "AutoGenerateSelfSigned": true,
    "UseDevelopmentCertificate": true
  },
  "Storage": {
    "Directory": "data/messages"
  },
  "Web": {
    "Enabled": true,
    "Port": 8888,
    "BindAddress": "127.0.0.1",
    "Title": "smtp-mockup",
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "MaxHtmlPreviewBytes": 2097152,
    "LiveUpdateDebounceMilliseconds": 250,
    "WatchDirectory": true,
    "ShowRawMimeDownload": true
  },
  "AllowedHosts": "*"
}
