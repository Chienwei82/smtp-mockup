@page "/about"
@inject IOptions<SmtpMockupOptions> Options

<PageHeader Text="Acerca de" />

<MudText Typo="Typo.h1" Class="mb-4">Acerca de smtp-mockup</MudText>

<MudPaper Class="pa-4" Elevation="0">
    <MudSimpleTable Dense="true" Elevation="0" data-testid="about">
        <tbody>
            <tr><th scope="row">Versión</th><td>@Version</td></tr>
            <tr><th scope="row">Función</th><td>Servidor SMTP local que guarda todo lo que recibe y lo muestra en esta UI</td></tr>
            <tr>
                <th scope="row">SMTP en claro</th>
                <td>@(_config.Smtp.Plain.Enabled ? EndpointAddress.FormatHostPort(_config.Smtp.Plain.BindAddress, _config.Smtp.Plain.Port) : "deshabilitado")</td>
            </tr>
            <tr>
                <th scope="row">SMTP STARTTLS</th>
                <td>@(_config.Smtp.StartTls.Enabled ? $"{EndpointAddress.FormatHostPort(_config.Smtp.StartTls.BindAddress, _config.Smtp.StartTls.Port)} ({_config.Smtp.StartTls.Security})" : "deshabilitado")</td>
            </tr>
            <tr><th scope="row">UI</th><td>@(_config.Web.Enabled ? EndpointAddress.FormatHttpUrl(_config.Web.BindAddress, _config.Web.Port) : "deshabilitada")</td></tr>
            <tr><th scope="row">Autenticación</th><td>ninguna, ni en SMTP ni en la UI: es una herramienta local</td></tr>
        </tbody>
    </MudSimpleTable>
</MudPaper>

<MudAlert Severity="Severity.Info" Class="mt-4">
    @if (_config.Smtp.Plain.Enabled)
    {
        <text>Envía un correo con <code>@($"swaks --server {EndpointAddress.FormatHostPort(_config.Smtp.Plain.BindAddress, _config.Smtp.Plain.Port)} --from a@b.com --to c@d.com --body hola")</code></text>
    }
    else
    {
        <text>El listener SMTP en claro está deshabilitado (<code>Smtp:Plain:Enabled=false</code>), así que hay que usar el puerto @(_config.Smtp.StartTls.Port).</text>
    }
    y aparecerá en el listado sin recargar la página.
</MudAlert>

@code {
    private SmtpMockupOptions _config = new();

    /// <summary>Versión del ensamblado en ejecución.</summary>
    private static string Version
        => typeof(AboutPage).Assembly.GetName().Version?.ToString() ?? "(desconocida)";

    /// <inheritdoc />
    protected override void OnInitialized() => _config = Options.Value;
}