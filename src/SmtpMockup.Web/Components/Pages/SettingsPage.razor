@page "/settings"
@inject IOptions<SmtpMockupOptions> Options
@inject IMessageStore Store

<PageHeader Text="Estado" />

<MudText Typo="Typo.h1" Class="mb-4">Estado del proceso</MudText>

<div class="stat-grid">
    <MudPaper Class="stat-card" Elevation="0">
        <div class="stat-card__label">Tiempo activo</div>
        <div class="stat-value" data-testid="uptime">@Uptime</div>
    </MudPaper>
    <MudPaper Class="stat-card" Elevation="0">
        <div class="stat-card__label">Mensajes almacenados</div>
        <div class="stat-value" data-testid="stored-count">@_storedCount</div>
    </MudPaper>
    <MudPaper Class="stat-card" Elevation="0">
        <div class="stat-card__label">Directorio escribible</div>
        <MudChip T="string" Color="@(_writable ? Color.Success : Color.Error)" data-testid="writable">
            @(_writable ? "sí" : "no")
        </MudChip>
    </MudPaper>
</div>

<MudPaper Class="pa-4" Elevation="0">
    <MudText Typo="Typo.h2" Class="section-title">Configuración efectiva</MudText>
    <MudSimpleTable Dense="true" Elevation="0" data-testid="effective-config">
        <tbody>
            <tr><th scope="row">SMTP plano</th><td>@Endpoint(_config.Smtp.Plain)</td></tr>
            <tr><th scope="row">SMTP STARTTLS</th><td>@Endpoint(_config.Smtp.StartTls)</td></tr>
            <tr><th scope="row">Tamaño máximo de mensaje</th><td>@_config.Smtp.MaxMessageSizeMb MB</td></tr>
            <tr><th scope="row">Certificado</th><td>@_config.Certificate.Mode — <code>@_config.Certificate.Path</code></td></tr>
            <tr><th scope="row">Directorio de mensajes</th><td><code>@StorageDirectory</code></td></tr>
            <tr><th scope="row">MIME crudo</th><td>@(_config.Storage.KeepRawMime ? "conservado" : "descartado")</td></tr>
            <tr><th scope="row">UI</th><td>@(_config.Web.Enabled ? EndpointAddress.FormatHttpUrl(_config.Web.BindAddress, _config.Web.Port) : "deshabilitada")</td></tr>
            <tr><th scope="row">Vigilancia del directorio</th><td>@(_config.Web.WatchDirectory ? "activa" : "desactivada")</td></tr>
            <tr><th scope="row">Actualización en vivo</th><td>debounce de @_config.Web.LiveUpdateDebounceMilliseconds ms</td></tr>
            <tr><th scope="row">Paginación</th><td>@_config.Web.DefaultPageSize por defecto, tope @_config.Web.MaxPageSize</td></tr>
            <tr><th scope="row">Límite de HTML</th><td>@_config.Web.MaxHtmlPreviewBytes bytes</td></tr>
            <tr><th scope="row">Registro</th><td>@_config.Hosting.Mode — @_config.Hosting.LogDirectory</td></tr>
        </tbody>
    </MudSimpleTable>
</MudPaper>

@code {
    private readonly DateTimeOffset _startedAt = DateTimeOffset.UtcNow;
    private SmtpMockupOptions _config = new();
    private int _storedCount;
    private bool _writable;
    private string StorageDirectory { get; set; } = "(sin directorio)";

    /// <summary>Texto del tiempo activo.</summary>
    private string Uptime => FormatUptime(DateTimeOffset.UtcNow - _startedAt);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _config = Options.Value;
        _storedCount = await Store.CountAsync();
        StorageDirectory = HostPath.Resolve(_config.Storage.Directory);
        _writable = CheckWritable(StorageDirectory);
    }

    /// <summary>Texto de un <see cref="TimeSpan"/> sin dependencias de localización.</summary>
    internal static string FormatUptime(TimeSpan uptime)
        => uptime.TotalDays >= 1
            ? $"{(int)uptime.TotalDays}d {uptime.Hours}h {uptime.Minutes}m"
            : uptime.TotalHours >= 1
                ? $"{(int)uptime.TotalHours}h {uptime.Minutes}m"
                : $"{Math.Max(uptime.Minutes, 0)}m {uptime.Seconds}s";

    /// <summary>Describe un endpoint SMTP según esté habilitado o no.</summary>
    private static string Endpoint(SmtpEndpointOptions options)
        => options.Enabled
            ? $"{EndpointAddress.FormatHostPort(options.BindAddress, options.Port)} ({options.Security})"
            : "deshabilitado";

    /// <summary>
    /// Comprueba que el directorio acepte escrituras. Se hace de verdad, con un archivo temporal
    /// que se borra: comprobar los permisos declarados no dice nada si el proceso corre como
    /// una cuenta con menos privilegios de los que dice el ACL.
    /// </summary>
    internal static bool CheckWritable(string directory)
    {
        var probe = Path.Combine(directory, $".smtp-mockup-write-probe-{Environment.ProcessId}");
        try
        {
            File.WriteAllText(probe, "probe");
            return true;
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
        {
            return false;
        }
        finally
        {
            try
            {
                if (File.Exists(probe))
                {
                    File.Delete(probe);
                }
            }
            catch (IOException)
            {
                // Nada que hacer: es un archivo temporal en el directorio de datos.
            }
        }
    }
}