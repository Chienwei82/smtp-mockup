@inherits LayoutComponentBase
@inject IOptions<WebOptions> WebOptions

<MudThemeProvider Theme="@MockupTheme.Instance" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Primer foco de la página: con Tab se salta toda la navegación y se va directo al contenido. *@
<a class="skip-link" href="#main-content">Saltar al contenido</a>

@* Barra superior del export: marca configurable (Web:Title) y nada más; la navegación vive en el
   nav rail, no aquí: meterla en la barra la dejaba ilegible en pantallas estrechas. *@
<header class="top-bar">
    <div class="top-bar__brand">
        <span class="top-bar__icon" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.Mail" />
        </span>
        <span class="top-bar__title">@Title</span>
    </div>
    <div class="top-bar__spacer"></div>
</header>

<div class="shell">
    <nav class="nav-rail" aria-label="Navegación principal">
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
            <span class="nav-item__icon-wrap"><MudIcon Icon="@Icons.Material.Filled.Inbox" /></span>
            Mensajes
        </NavLink>
        <NavLink class="nav-item" href="stats" Match="NavLinkMatch.Prefix">
            <span class="nav-item__icon-wrap"><MudIcon Icon="@Icons.Material.Filled.QueryStats" /></span>
            Estadísticas
        </NavLink>
        <NavLink class="nav-item" href="settings" Match="NavLinkMatch.Prefix">
            <span class="nav-item__icon-wrap"><MudIcon Icon="@Icons.Material.Filled.Settings" /></span>
            Estado
        </NavLink>
        <NavLink class="nav-item" href="about" Match="NavLinkMatch.Prefix">
            <span class="nav-item__icon-wrap"><MudIcon Icon="@Icons.Material.Filled.Info" /></span>
            Acerca de
        </NavLink>
    </nav>

    @* tabindex=-1 para que el enlace «saltar al contenido» (y FocusOnNavigate) puedan enfocarlo. *@
    <main id="main-content" class="main" tabindex="-1">
        @Body
    </main>
</div>

@* Bottom nav del export: es el mismo menú en móvil. La que no corresponde al ancho de pantalla va
   con display:none, así que sólo una de las dos está en el árbol de accesibilidad. *@
<nav class="bottom-nav" aria-label="Navegación principal">
    <div class="bottom-nav__items">
        <NavLink class="bottom-nav__item" href="" Match="NavLinkMatch.All">
            <span class="bottom-nav__item-icon"><MudIcon Icon="@Icons.Material.Filled.Inbox" /></span>
            Mensajes
        </NavLink>
        <NavLink class="bottom-nav__item" href="stats" Match="NavLinkMatch.Prefix">
            <span class="bottom-nav__item-icon"><MudIcon Icon="@Icons.Material.Filled.QueryStats" /></span>
            Estadísticas
        </NavLink>
        <NavLink class="bottom-nav__item" href="settings" Match="NavLinkMatch.Prefix">
            <span class="bottom-nav__item-icon"><MudIcon Icon="@Icons.Material.Filled.Settings" /></span>
            Estado
        </NavLink>
        <NavLink class="bottom-nav__item" href="about" Match="NavLinkMatch.Prefix">
            <span class="bottom-nav__item-icon"><MudIcon Icon="@Icons.Material.Filled.Info" /></span>
            Acerca de
        </NavLink>
    </div>
</nav>

@code {
    /// <summary>
    /// Título de la barra superior. Sale de la configuración y no de un literal, para que
    /// <c>Web:Title</c> (documentada en la SPEC) tenga efecto en algún sitio. Si viene vacío
    /// se usa el nombre por defecto: una opción de presentación nunca debe dejar la UI sin
    /// nombre por un valor mal escrito en el JSON.
    /// </summary>
    private string Title => string.IsNullOrWhiteSpace(WebOptions.Value.Title)
        ? "smtp-mockup"
        : WebOptions.Value.Title;
}