@inherits LayoutComponentBase
@inject IOptions<WebOptions> WebOptions

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIcon Icon="@Icons.Material.Filled.Mail" Class="mr-2" />
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudSpacer />
        <MudNavMenu Bordered="true" Margin="Margin.Dense" Color="Color.Inherit">
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Inbox">Mensajes</MudNavLink>
            <MudNavLink Href="stats" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.QueryStats">Estadísticas</MudNavLink>
            <MudNavLink Href="settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">Estado</MudNavLink>
            <MudNavLink Href="about" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Info">Acerca de</MudNavLink>
        </MudNavMenu>
    </MudAppBar>

    <MudMainContent Class="pt-6 pb-8">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    /// <summary>
    /// Título de la barra superior. Sale de la configuración y no de un literal, para que
    /// <c>Web:Title</c> (documentada en la SPEC) tenga efecto en algún sitio. Si viene vacío
    /// se usa el nombre por defecto: una opción de presentación nunca debe dejar la UI sin
    /// nombre por un valor mal escrito en el JSON.
    /// </summary>
    private string Title => string.IsNullOrWhiteSpace(WebOptions.Value.Title)
        ? "smtp-mockup"
        : WebOptions.Value.Title;
}