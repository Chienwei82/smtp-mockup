@* Diálogo de confirmación propio, sin IDialogService de MudBlazor: no necesita JavaScript, se
   puede probar con bUnit sin configurar el interop, y el borrado nunca debe depender de un
   popup que el navegador pueda bloquear (SPEC §9.3). *@

@if (Visible)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300" />
    <MudPaper Class="confirm-dialog pa-6" Elevation="8" role="alertdialog" aria-modal="true"
              aria-labelledby="confirm-dialog-title" aria-describedby="confirm-dialog-message">
        <MudText Typo="Typo.h4" Class="mb-2" id="confirm-dialog-title">@Title</MudText>
        <MudText Class="mb-4" id="confirm-dialog-message">@Message</MudText>
        <div class="d-flex justify-end gap-2">
            @* autofocus: al abrirse, el foco cae en «Cancelar» — la opción segura de un diálogo
               destructivo. Un <button> recién insertado con autofocus lo enfoca el navegador. *@
            <MudButton Color="Color.Default" Variant="Variant.Text" OnClick="CancelAsync"
                       autofocus data-testid="confirm-cancel">@CancelText</MudButton>
            <MudButton Color="@ConfirmColor" Variant="Variant.Filled" OnClick="ConfirmAsync"
                       data-testid="confirm-accept">@ConfirmText</MudButton>
        </div>
    </MudPaper>
}

@code {
    /// <summary>Si el diálogo se está mostrando.</summary>
    [Parameter]
    public bool Visible { get; set; }

    /// <summary>Título del diálogo.</summary>
    [Parameter]
    public string Title { get; set; } = "Confirmar";

    /// <summary>Texto explicativo de qué se va a hacer.</summary>
    [Parameter]
    public string Message { get; set; } = string.Empty;

    /// <summary>Texto del botón que acepta.</summary>
    [Parameter]
    public string ConfirmText { get; set; } = "Aceptar";

    /// <summary>Texto del botón que cancela.</summary>
    [Parameter]
    public string CancelText { get; set; } = "Cancelar";

    /// <summary>Color del botón de confirmar: rojo en los borrados.</summary>
    [Parameter]
    public Color ConfirmColor { get; set; } = Color.Primary;

    /// <summary>Se invoca al aceptar.</summary>
    [Parameter]
    public EventCallback OnConfirm { get; set; }

    /// <summary>Se invoca al cancelar.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    private Task ConfirmAsync() => OnConfirm.InvokeAsync();

    private Task CancelAsync() => OnCancel.InvokeAsync();
}